# BhuLekh-AI Environment Configuration
# Copy to .env before running: cp .env.example .env
# Never commit .env to version control.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bhulekh:bhulekh_dev@postgres:5432/bhulekh
DATABASE_URL_SYNC=postgresql://bhulekh:bhulekh_dev@postgres:5432/bhulekh
POSTGRES_USER=bhulekh
POSTGRES_PASSWORD=bhulekh_dev
POSTGRES_DB=bhulekh

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bhulekh
MINIO_SECURE=false

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string-here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── OCR / ML feature flags ────────────────────────────────────────────────────
ENABLE_TROCR=false
ENABLE_NER=false
ENABLE_VLM_FALLBACK=false
ENABLE_YOLO=false

# ── Confidence thresholds ─────────────────────────────────────────────────────
AUTO_ACCEPT_THRESHOLD=0.90
CRITICAL_FIELD_THRESHOLD=0.92
REVIEW_THRESHOLD=0.75

# ── Localisation ──────────────────────────────────────────────────────────────
DEFAULT_LANG=hi

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
CELERY_WORKERS=2

# ── Frontend (used at build time only) ────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_ENV=development
